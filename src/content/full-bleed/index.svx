## Custom properties

| Property name         | Default value    |
| --------------------- | ---------------- |
| `--full-bleed-measure--component`    | `var(--measure)` |
| `--full-bleed-side-space--component`  | `var(--s-1)`     |
| `--full-bleed-stack-space--component` | `var(--s-1)`     |

<PropSelect options={measure_options} name={'--full-bleed-measure--component'} bind:value={fullBleedMeasure} />
<PropSelect options={space_options} name={'--full-bleed-side-space--component'} bind:value={fullBleedSideSpace} />
<PropSelect options={space_options} name={'--full-bleed-stack-space--component'} bind:value={fullBleedStackSpace} />

<SqueezeContainer>
	<div class="l-full-bleed"
		style="
			--full-bleed-measure: {fullBleedMeasure};
			--full-bleed-side-space: {fullBleedSideSpace};
			--full-bleed-stack-space: {fullBleedStackSpace};
				"
			>
		<span>Item</span>
		<span class="u-full-bleed--1">.u-full-bleed</span>
		<span>Item</span>
		<span class="u-full-bleed--2">.u-full-bleed--2</span>
		<span>Item</span>
	</div>
</SqueezeContainer>

